{
  "name": "meadow",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Modern web client for mooR - a 21st century LambdaMOO implementation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "VITE_WEBHOOKS_ENABLED=true vite",
    "build": "npm run typecheck:app && npm run typecheck:worker && vite build",
    "build:deb": "npm run build && ./deploy/debian-packages/build-web-client-deb.sh",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker && npm run typecheck:test && npm run typecheck:node && npm run typecheck:e2e",
    "clean": "rimraf dist",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "moor:dev": "cd ${MOOR_PATH:-../..} && npm run moor:dev",
    "moor:dev:oauth2": "cd ${MOOR_PATH:-../..} && npm run moor:dev:oauth2",
    "full:dev": "concurrently \"npm run dev\" \"npm run moor:dev\"",
    "full:dev:oauth2": "concurrently \"npm run dev\" \"npm run moor:dev:oauth2\"",
    "bundle:check": "node scripts/check-bundle.mjs",
    "test:bundle": "node --test scripts/check-bundle.test.mjs",
    "typecheck:app": "node ../../tools/tsc.mjs --noEmit -p tsconfig.json",
    "typecheck:worker": "node ../../tools/tsc.mjs --noEmit -p tsconfig.worker.json",
    "typecheck:test": "node ../../tools/tsc.mjs --noEmit -p tsconfig.test.json",
    "typecheck:node": "node ../../tools/tsc.mjs --noEmit -p tsconfig.node.json",
    "version:check": "node scripts/version.mjs check",
    "test:version": "node --test scripts/version.test.mjs",
    "prebuild": "npm run version:check",
    "test:changes": "playwright test --config playwright.config.ts",
    "typecheck:e2e": "node ../../tools/tsc.mjs --noEmit -p tsconfig.e2e.json"
  },
  "keywords": [
    "moo",
    "lambdamoo",
    "typescript",
    "web-client",
    "mud-client",
    "moo-client"
  ],
  "author": "Ryan Daum <ryan.daum@gmail.com>",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/timbran-project/moor.git",
    "directory": "clients/meadow"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "rimraf": "^6.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@djot/djot": "^0.3.2",
    "@monaco-editor/react": "^4.7.0",
    "@moor/schema": "2.0.0-dev",
    "@moor/web-sdk": "2.0.0-dev",
    "@tauri-apps/api": "^2.9.1",
    "age-encryption": "^0.2.4",
    "ansi_up": "^6.0.6",
    "argon2-browser": "^1.18.0",
    "dompurify": "^3.4.16",
    "flatbuffers": "^25.9.23",
    "monaco-editor": "^0.57.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-avatar-editor": "^15.2.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
