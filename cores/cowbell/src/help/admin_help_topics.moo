object ADMIN_HELP_TOPICS [
  import_export_id -> "admin_help_topics",
  import_export_hierarchy -> {"help"}
]
  name: "Admin Help Topics"
  parent: HELP_SOURCE
  location: PROTOTYPE_BOX
  owner: ARCH_WIZARD
  readable: true

  property topic_administration_changes (owner: ARCH_WIZARD, flags: "rc") = {
    "@changes",
    "Review and apply code changes",
    "Fetch upstream code, compare it with your running MOO, and choose what to install. All commands below work from plain telnet. Meadow and agent tools use the same guarded service.\n\nIn Meadow, start with **Check for updates**. Search covers every review page. **Review planned effects** shows what the entire selection will do before **Confirm apply**. **Results** lists committed effects, including later pages. **Finish review** keeps installed changes and leaves deferred work for a later update. **Minimize review** hides the panel without losing an unsaved draft. Settings, source uploads, and history repair are separate tasks.\n\n## A normal update\n\n1. Use `@changes fetch` to check the default package for updates.\n2. Use `@changes diff` to open the review when fetching finishes.\n3. Use `@changes compare ROW` to compare one item. ROW is its number in the list.\n4. Save your decisions, then use `@changes preview` to read the exact effects.\n5. Use `@changes apply` to install that prepared selection.\n6. Use `@changes status` and `@changes result` to read what actually happened.\n7. After a partial apply, use `@changes diff` to continue, or `@changes finish` to close the review.\n\nFinishing keeps earlier committed changes. It leaves deferred contents and baselines unchanged. It releases the package so you can check for another update. There is no general rollback command.\n\nShort commands use the review last displayed on this connection. They remember its version and row identities. Another session cannot silently move your choice to a different item. If the review changes elsewhere, read `@changes diff` again. `@changes status` alone does not approve a new row list.\n\n## Decide what to do\n\n* `@changes incoming ROW` — Replace an existing program with upstream code and record that upstream baseline.\n* `@changes keep ROW` — Keep your live program, but acknowledge the incoming baseline for future comparisons.\n* `@changes later ROW` — Keep both your live contents and the old baseline unchanged.\n* `@changes edit ROW` — Write or continue an edited program. Saving validates a review choice; it does not change live code.\n\nThese meanings apply to existing programs. New objects, verbs, and properties have separate checks. Existing property values and object attributes remain unchanged.\n\nThe accepted baseline is the upstream version you last accepted. An unknown baseline means the service cannot reliably identify local edits. A known baseline with missing source text is different: its identity is known, but its text is not loaded. Use `@changes base ROW` to retrieve available Git history, then `@changes source ROW base` to read it. Do not adopt source merely to remove a blocker.\n\n## Edit a draft from telnet\n\nThe editor keeps each submitted line. New lines append to a saved buffer. It starts empty when no edited choice or draft exists.\n\n* `.` — Validate the buffer and save it as the edited choice.\n* `@abort` — Leave the editor and keep the buffer. Your existing review choice remains unchanged.\n* `.show [OFFSET]` — Read numbered lines from the buffer.\n* `.clear` — Clear the buffer so you can paste a replacement program.\n* `.delete NUMBER` — Remove one numbered line.\n\nPrefix a literal leading dot with another dot. Compiler errors identify the line that needs correction. Reopen `@changes edit ROW` to repair the saved draft. Apply remains blocked until the selected edited program is valid.\n\nAfter reconnecting, use `@changes drafts`. Open the indicated review with `@changes diff ID`, then edit the matching row. If another session changed the review during editing, the buffer survives but the old choice is not saved. Read the current comparison before saving again.\n\n`@changes draft ID [OFFSET]` reads a saved buffer, including one whose member disappeared. `@changes forget-draft ID` removes that buffer only. It does not remove a saved review choice. The service keeps up to 128 buffers within 8 MiB, with at most 512 KiB per buffer.\n\n## Read more and recover\n\n* `@changes next` — Read the next review page from the same displayed version.\n* `@changes compare ROW [OFFSET]` — Page through the local-to-upstream comparison.\n* `@changes source ROW live|incoming|base [OFFSET]` — Read one full source version.\n* `@changes preview [OFFSET]` — Page through planned effects. Counts cover the whole review, including unopened pages.\n* `@changes result [ID [OFFSET]]` — Read recorded decisions from an apply.\n* `@changes history [PACKAGE [OFFSET]]` — Read retained review history.\n* `@changes details` — Read upstream provenance and source limitations.\n* `@changes refresh` — Compare the saved source again after live contents change.\n* `@changes recovery [OFFSET]` — Find saved decisions that need another check.\n* `@changes recovery-source NUMBER [OFFSET]` — Read an edited program from that recovery list.\n* `@changes retry` — Replace a failed fetch with a new attempt after fixing its source or worker.\n* `@changes discard` — Abandon the pending review. Earlier committed changes remain installed.\n\nRefresh preserves unaffected choices and keeps changed drafts for recovery. It does not silently approve changed evidence. History retains up to 64 whole reviews within 32 MiB; old records expire as whole reviews.\n\n## Related additions\n\nAn updated program can need a new helper. Put the caller and helper in one group. The service cannot discover every dependency from code.\n\n* `@changes group NAME ROW ... [requires=NAME,NAME]` — Declare the members and prerequisite groups.\n* `@changes select-group NAME` — Select the group while preserving explicit member choices and drafts.\n* `@changes skip-group NAME` — Defer the whole group.\n* `@changes remove-group NAME` — Remove the declaration while preserving saved work.\n* `@changes initialize ROW [descendants]` — Permit the displayed initial property value, only where no property exists.\n\nAfter changing policy, open `@changes diff` again. Declaring a group does not select its members. Apply rejects missing requirements and incomplete selections. Before initializing a parent property, inspect its value and explicitly permit descendants to inherit it when required. Existing data is never overwritten by initialization.\n\n## Package setup and history repair\n\n* `@changes packages` — List packages, their versions, and active reviews.\n* `@changes diff ID` — Open another saved review.\n* `@changes fetch PACKAGE` — Fetch another package.\n* `@changes package NAME #OBJECT ...` — Configure package membership.\n* `@changes upstream [PACKAGE] URL` — Configure an HTTP source.\n* `@changes upstream [PACKAGE] git REPOSITORY FULL-REF-OR-COMMIT [PATH]` — Configure a Git source and optional repository subdirectory.\n* `@changes bindings PACKAGE GENERATION NAME=#ID ... [complete]` — Bind proposed objects to explicit absent addresses.\n* `@changes adopt PACKAGE` — Prepare an explicit history-repair review. Applying adoption records baselines without replacing live programs.\n\nGit and new object creation require an actual wizard. Preview never reserves an object ID. Apply checks that the chosen address is still absent. New objects run no initialization hooks. Complete source reports unsupported omissions; partial source keeps omitted members. Neither mode deletes objects or migrates data.\n\nExplicit review-ID and generation forms remain available for scripts, such as `@changes resolve ID GENERATION ROW incoming` and `@changes apply ID GENERATION`. Ordinary interactive use does not need those numbers.\n\n## Agent access\n\nCowbell exposes `changes_*` tools through both MCP hosts and its internal agents. Connect as an administrator and read `moor://changes-guide`. Asking to find updates permits inspection. Asking to find and merge updates permits guarded apply. The agent must preserve local work, ask about unresolved policy choices, and report committed results.",
    {"changes", "upgrades"},
    'administration,
    {"@sudo"}
  };
  property topic_administration_dump_database (owner: ARCH_WIZARD, flags: "rc") = <HELP, .name = "@dump-database", .content = "Usage: `@dump-database`\n\nManually triggers a database dump to disk.\n\nOnly admins can use this command.", .aliases = {"dump", "checkpoint", "save"}, .category = 'administration, .summary = "Trigger database dump", .see_also = {}>;
  property topic_administration_overview (owner: ARCH_WIZARD, flags: "rc") = {
    "administration",
    "Administration commands",
    "Commands for delegated administration and auditing:\n\n`@sudo`, `@sudo-grant`, `@sudo-allow`, `@sudo-revoke`, `@sudo-show`, `@sudo-who`, `@sudo-log`, `@dump-database`\n\nTypical flow: `@sudo-grant` -> `@sudo-allow` -> validate with `@sudo-show` -> audit with `@sudo-log`.\n\nImportant: `@sudo` is an allowlisted command-dispatch facility, not a universal permission elevator. Some privileged operations still require dedicated admin verbs.",
    {"admin", "sudo", "management"},
    'administration,
    {"@sudo", "@sudo-grant", "@sudo-allow", "@sudo-show", "@sudo-log"}
  };
  property topic_administration_sudo (owner: ARCH_WIZARD, flags: "rc") = {
    "@sudo",
    "Run an allowlisted delegated admin command",
    "Usage: `@sudo <command>`\n\nRuns an allowlisted command through delegated admin dispatch.\n\nImportant limitations:\n- This is not universal command elevation.\n- `set_task_perms()` scope does not make arbitrary downstream command execution fully transitive.\n- Some operations (for example direct property/verb mutation commands) may still fail unless exposed as dedicated admin verbs.\n\nAllowlist entries can be plain verb names (for example `@llm-budget`) or object-scoped tokens (`#11::@dig`).\n\nTroubleshooting:\n- `@sudo @rmprop ...` returning permission denied usually means that operation is outside current delegated-dispatch guarantees.\n- Check your grant and allowlist with `@sudo-show <player>`.\n- Check active entries with `@sudo-who` and recent audit events with `@sudo-log`.",
    {"sudo", "@sudo", "sudo-cmd"},
    'administration,
    {"@sudo-grant", "@sudo-allow", "@sudo-show", "@sudo-who", "@sudo-log"}
  };
  property topic_administration_sudo_allow (owner: ARCH_WIZARD, flags: "rc") = {
    "@sudo-allow",
    "Set sudo allowlist",
    "Usage: `@sudo-allow <player> to <verb|obj::verb,...>`\n\nSets the list of command verbs a player may run via `@sudo`.\n\nExamples:\n- `@sudo-allow Ryan to @llm-budget,@dump-database`\n- `@sudo-allow Ryan to #11::@dig`\n- `@sudo-allow Ryan to *`\n\nLeast-privilege guidance:\n- Prefer `obj::verb` entries over plain verb names.\n- Avoid `*` except for tightly controlled temporary situations.\n- Keep lists focused on commands with expected delegated behavior.",
    {"sudo-allow", "allow sudo"},
    'administration,
    {"@sudo-grant", "@sudo-revoke", "@sudo-show", "@sudo-log"}
  };
  property topic_administration_sudo_grant (owner: ARCH_WIZARD, flags: "rc") = <HELP, .name = "@sudo-grant", .content = "Usage: `@sudo-grant <player> as <wizard_player>`\n\nConfigures a player to execute commands as a specified wizard delegate via `@sudo`. If the player has no allowlist yet, a default seed is created.", .aliases = {"sudo-grant", "grant sudo", "sudo-grant"}, .category = 'administration, .summary = "Grant sudo delegation", .see_also = {"@sudo-revoke", "@sudo-allow"}>;
  property topic_administration_sudo_log (owner: ARCH_WIZARD, flags: "rc") = <HELP, .name = "@sudo-log", .content = "Usage: `@sudo-log [N]`\n\nShows the most recent N sudo audit entries (default 20).", .aliases = {"sudo-log", "sudo audit", "sudo-audit"}, .category = 'administration, .summary = "Show sudo audit log", .see_also = {"@sudo-who"}>;
  property topic_administration_sudo_revoke (owner: ARCH_WIZARD, flags: "rc") = <HELP, .name = "@sudo-revoke", .content = "Usage: `@sudo-revoke <player>`\n\nRemoves sudo delegation, allowlist entries, and clears active sudo task markers for that player.", .aliases = {"sudo-revoke", "revoke sudo", "sudo-revoke"}, .category = 'administration, .summary = "Revoke sudo delegation", .see_also = {"@sudo-grant", "@sudo-allow"}>;
  property topic_administration_sudo_show (owner: ARCH_WIZARD, flags: "rc") = <HELP, .name = "@sudo-show", .content = "Usage: `@sudo-show <player>`\n\nShows delegate mapping, allowlist, and active sudo task entries for a player.", .aliases = {"sudo-show", "show sudo", "sudo-show"}, .category = 'administration, .summary = "Show sudo state for a player", .see_also = {"@sudo-who", "@sudo-allow"}>;
  property topic_administration_sudo_who (owner: ARCH_WIZARD, flags: "rc") = <HELP, .name = "@sudo-who", .content = "Usage: `@sudo-who`\n\nLists active sudo tasks and recent sudo audit log entries.", .aliases = {"sudo-who", "sudo active", "sudo-active"}, .category = 'administration, .summary = "Show active sudo and recent audit", .see_also = {"@sudo-show", "@sudo-log"}>;

  override topic_order (owner: ARCH_WIZARD, flags: "rc") = {
    'topic_administration_changes,
    'topic_administration_overview,
    'topic_administration_sudo,
    'topic_administration_sudo_grant,
    'topic_administration_sudo_allow,
    'topic_administration_sudo_revoke,
    'topic_administration_sudo_show,
    'topic_administration_sudo_who,
    'topic_administration_sudo_log,
    'topic_administration_dump_database
  };
endobject
