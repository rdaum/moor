object BUILDER_HELP_TOPICS [
  import_export_id -> "builder_help_topics",
  import_export_hierarchy -> {"help"}
]
  name: "Builder Help Topics"
  parent: HELP_SOURCE
  location: PROTOTYPE_BOX
  owner: ARCH_WIZARD
  readable: true

  property topic_building_dig (owner: ARCH_WIZARD, flags: "rc") = <HELP, .content_kind = 'djot_blocks, .name = "@dig", .content = "Create a passage to an existing room in the same area.\n\nUsage:\n\n- `@dig [--dry-run] [--allow-parallel] [oneway] DIR[|RETURNDIR] to ROOM`\n\nExamples:\n\n- `@dig north to Library`\n- `@dig n,ne|s,sw to #123`\n- `@dig oneway hatch to Maintenance`\n- `@dig --dry-run north to Lobby`\n\nNotes:\n\n- Without `|RETURNDIR`, opposite directions are inferred when possible.\n- `--allow-parallel` allows multiple passages between the same room pair.", .aliases = {"@tunnel", "dig", "tunnel", "passage"}, .category = 'building, .summary = "Create a passage", .see_also = {"@undig", "@passage", "@set-passage"}>;
  property topic_building_overview (owner: ARCH_WIZARD, flags: "rc") = <HELP, .content_kind = 'djot_blocks, .name = "building", .content = "You will need builder or programmer privileges to use these commands. If you don't have builder or programmer privileges, ask a wizard to grant builder privileges.\n\nCommands for creating and organizing the world:\n\n`@create`, `@recycle`, `@dig`, `@undig`, `@passage`, `@set-passage`, `@rename`, `@describe`, `@edit-description`, `@parent`, `@children`, `@integrate`, `@move`, `@messages`, `@rules`, `@reaction`, `@state`, `@rule`, `@parents`, `@set-thumbnail`, `@set-pronouns`, `@grant`, `@audit`, `@build`, `#`\n\nUse `help <command>` for details on each command.", .aliases = {"build", "create", "world"}, .category = 'building, .summary = "Builder commands", .see_also = {"programming"}>;
  property topic_building_passage (owner: ARCH_WIZARD, flags: "rc") = <HELP, .content_kind = 'djot_blocks, .name = "@passage", .content = "Show detailed information for a passage from the current room.\n\nUsage:\n\n- `@passage DIRECTION`\n\nShows:\n\n- label and aliases\n- description and prose style\n- departure/arrival phrases\n- destination and return side info\n- open/locked state", .aliases = {"@passage-info", "@pinfo", "passage info"}, .category = 'building, .summary = "Show passage details", .see_also = {"@set-passage", "@dig", "@undig"}>;
  property topic_building_set_passage (owner: ARCH_WIZARD, flags: "rc") = <HELP, .content_kind = 'djot_blocks, .name = "@set-passage", .content = "Edit properties of a passage from the current room.\n\nUsage:\n\n- `@set-passage DIRECTION PROPERTY VALUE`\n\nProperties:\n\n- `description`\n- `departure`\n- `arrival`\n- `style` (`sentence` or `fragment`)\n- `aliases` (comma-separated)\n- `is_door` (`true/false`, also `yes/no`, `1/0`, `on/off`)\n\n`is_door` controls whether `open/close/lock/unlock` treat the exit as a door.", .aliases = {"@setp", "set passage", "passage edit", "is_door"}, .category = 'building, .summary = "Edit passage properties", .see_also = {"@passage", "@dig", "@undig"}>;
  property topic_building_undig (owner: ARCH_WIZARD, flags: "rc") = <HELP, .content_kind = 'djot_blocks, .name = "@undig", .content = "Remove a passage from the current room.\n\nUsage:\n\n- `@undig DIRECTION`\n- `@undig ROOM`\n\nExamples:\n\n- `@undig north`\n- `@undig Library`\n\nThe command checks builder permissions on the current room.", .aliases = {"@remove-exit", "@delete-passage", "undig", "remove exit"}, .category = 'building, .summary = "Remove a passage", .see_also = {"@dig", "@passage"}>;
  property topic_hash_lookup (owner: ARCH_WIZARD, flags: "rc") = <HELP, .content_kind = 'djot_blocks, .name = "#", .content = "`#` is a builder's Swiss army knife: find an object, read its properties, change a value, or call a verb. Start with `#me` to inspect yourself. Type `help hash` to open this help again.\n\n*Find an object*\n\n- `#lamp` finds a nearby object by name or alias.\n- `#me` finds you; `#here` finds your room.\n- `#123` finds object number 123. UUID object identifiers work too.\n- `#$actor` finds the actor prototype through its system name.\n- `#@Ada` finds a player by name.\n\nKeep the name attached to #, with no space. For a name containing spaces, use a short alias or the object's identifier. Normal lookup searches your inventory and room first, then players, then passages. If a name matches several objects, use a more specific name or identifier.\n\n*Read a property*\n\n- `#lamp.name` reads its name.\n- `#lamp.owner.name` reads its owner's name.\n- `#lamp.parent.name` reads its prototype's name. Here, .parent is a shortcut for parent().\n\n*Choose where to look*\n\n- `#lamp inventory` searches only what you carry.\n- `#Ada player` searches players.\n- `#north exit` inspects a passage from your room, using its label or an alias.\n\nA scope goes after the property chain: `#lamp.name inventory`.\n\n*Change a property (programmers)*\n\n- `#lamp.description = \"A small brass lamp.\"` assigns text.\n- `#lamp.brightness = 10` assigns a number, if that property exists.\n- `#lamp.brightness = 2 * 4` assigns a computed value.\n\nPut strings in double quotes. The property must already exist and you must be allowed to write it. Use @property to add one. Use @move, @parent, @describe, @set-pronouns, and other building commands when they provide the operation you need.\n\n*Call a verb or calculate a value (programmers)*\n\n`#Henri for %#:pronouns_display()` calls a verb on Henri. After for, %# means the selected object or property value. The expression runs with your permissions and its result is displayed.\n\n- `#lamp.owner for %#.name` reads the selected owner's name.\n- `#here.contents for length(%#)` counts the objects in your room.\n- `#lamp inventory for %#.description = \"A brass lamp.\"` combines a scope with assignment.\n\nUse one MOO expression after for; omit return. %# is a text substitution, so it is replaced even inside quoted strings. Assignment with = does not substitute %#. A direct :verb() suffix is not supported; use for as above.\n\n*Permissions and passages*\n\nLookup requires builder privileges. Assignment and for also require programmer privileges. Ordinary read, write, and verb permissions still apply. A permission error means the operation was denied.\n\nPassages are stored values, rather than independent objects. Use @passage, @set-passage, and @describe to edit them; changing a temporary passage value does not save it.\n\n*Credit*\n\nThis command follows the LambdaMOO/LambdaCore # utility. The bundled LambdaCore source records a copy made by Geust on May 9, 1993; it does not identify the original author.", .aliases = {"lookup", "find", "object-lookup", "hash"}, .category = 'building, .summary = "Find objects, inspect properties, and run expressions", .see_also = {"@property", "@show", "@passage", "programming"}>;

  property topic_set_pronouns (owner: ARCH_WIZARD, flags: "rc") = <HELP, .content_kind = 'djot_blocks, .name = "@set-pronouns", .content = "Set the pronouns used in messages about an actor, such as an NPC or player. You need builder privileges and must own the actor, or be a wizard. Programmer privileges are not required.\n\nUsage: `@set-pronouns ACTOR to PRESET|custom`\n\n## Choose a preset\n\n`@set-pronouns Henri to he/him`\n\nThe presets are `he/him`, `she/her`, `they/them`, `it/its`, and `e/em`. Use the actor's name, alias, or object identifier. If several objects match a name, use a more specific name or identifier.\n\nThe command confirms the actor's name and new pronouns. Other people can then see messages such as \"He has his coat.\" Words written directly into messages do not change.\n\n## Enter custom pronouns\n\n`@set-pronouns Henri to custom`\n\nAnswer five word prompts, then choose is or are for verb agreement. Read the preview sentences and confirm to save. Enter @abort at a word prompt, or answer no at confirmation, to keep the actor's current pronouns.\n\nPermission is checked again before saving. If you lose editing permission during the prompts, the command does not save your answers.\n\nFor your own pronouns, use `@pronouns PRESET` or `@pronouns custom`. Personal settings do not need builder privileges. See `help pronouns`.", .aliases = {"set-pronouns", "actor-pronouns", "npc-pronouns"}, .category = 'building, .summary = "Set an actor's pronouns", .see_also = {"pronouns", "messages", "#"}>;

  override topic_order (owner: ARCH_WIZARD, flags: "rc") = {
    'topic_building_overview,
    'topic_hash_lookup,
    'topic_set_pronouns,
    'topic_building_dig,
    'topic_building_undig,
    'topic_building_passage,
    'topic_building_set_passage
  };
endobject
