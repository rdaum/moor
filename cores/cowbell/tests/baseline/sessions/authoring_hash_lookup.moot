@programmer
% @create $actor named Henri
~~Created
% @property Henri.counter 0 rc
~~Added
% @property Henri.words 0 rc
~~Added
% @property Henri.food_kind #-1 rc
~~Added
% #Henri.counter = 7
~~.counter = 7
% #Henri.counter
==> 7
% #Henri.owner.name
==> "Ada"
% #Henri.parent.name
==> "Generic Actor"
% #90101.name
==> "Ada"
% #$actor.name
==> "Generic Actor"
% #Henri.counter = 3 * 4
~~.counter = 12
% #Henri.counter
==> 12
% #Henri.words = "%# stays literal"
~~.words = "%# stays literal"
% #Henri.pronouns = $pronouns:lookup("he/him")
~~.pronouns = <
% #Henri for %#:pronouns_display()
==> "he/him"
% #me for {task_perms()[1], player}
==> {#90101, #90101}
% @create $thing named kibble
~~Created
% #Henri.food_kind = $match:match_object("kibble", player)
~~.food_kind = #
% #Henri.food_kind.name
==> "kibble"

// Assignment does not require spaces around =, and preserves quoted text.
% #Henri.aliases={"box"}
~~.aliases = {"box"}
% #Henri.aliases
==> {"box"}
% #Henri.counter=13
~~.counter = 13
% #Henri.counter= 14
~~.counter = 14
% #Henri.counter =15
~~.counter = 15
% #Henri.counter = 12
~~.counter = 12
% #Henri.words="x.y:z = w"
~~.words = "x.y:z = w"
% #Henri.words
==> "x.y:z = w"
% @create $thing named "x=y"
~~Created
% #"x=y".aliases={"equal sign"}
~~.aliases = {"equal sign"}
% #"x=y".aliases
==> {"equal sign"}
% #Henri.counter for %# + 1
==> 13
% #Henri.name inventory
==> "Henri"
% #Ada.name player
==> "Ada"
% #east.side_a_label exit
==> "east"
% #e.side_a_label exit
==> "east"
% #east.side_a_label
==> "east"
% #east exit for %#:other_room(player.location) == #90110
==> true

// Malformed input stays an ordinary command error and preserves properties.
% #Henri.counter =
~~Missing value after =
% #Henri.counter=
~~Missing value after =
% #Henri.counter = 1 +
~~Invalid expression
% #Henri = 1
~~Assignment needs a property
% #Henri.parent = #1
~~Use @parent
% #Henri..name
~~A dot must be followed
% #Henri.unknown_property
~~Property .unknown_property not found
% #Henri.unknown_property = 3
~~Property .unknown_property not found
% #Henri.counter.name
~~Cannot access .name on 12
% #Henri.name inventory rubbish
~~Use exit, player, inventory
% #Henri for
~~Missing expression after for
% #Henri for raise(E_INVARG, "An expected expression failure.")
=An expected expression failure.
% #zzzzmissingobject
~~No match found
% #Henri.counter
==> 12

// Ambiguity must not select an arbitrary object or fall through to exits.
% @create $thing named twin
~~Created
% @create $thing named twin
~~Created
% #twin.name
~~More than one match
% #twin.name inventory
~~More than one match
% #twin.name = "wrong"
~~More than one match

