// Native service calls keep returning structured values; terminal apply gets a completion notice.
; load_object({"object #9500", tostr("owner: ", player), tostr("verb test (this none this) owner: ", player, " flags: \"rxd\""), "return 1;", "endverb", "endobject"}); $change_manager:configure("probe", {#9500}, []); const review = $change_manager:stage("probe", {["label" -> "probe.moo", "text" -> dump_object(#9500)]}, "adopt"); return {review["review_id"], review["status"]};
