@wizard
; status = []; for value, name in (db_counters()) status[tostr(name)] = value; endfor return status["persistence_healthy"] == {1, 0} && status["persistence_durable"][1] <= status["persistence_applied"][1] && status["persistence_applied"][1] <= status["persistence_published"][1] && status["persistence_outstanding"][1] >= 0;
1

@programmer
; db_counters();
E_PERM
